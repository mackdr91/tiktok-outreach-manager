# Author: Domonick Mack
# Date: 2026-11-15
# Description: Environment variable template for local Docker Compose and Railway deployments.

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="tokreach-super-secret-jwt-signing-key-change-in-production"

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://tokreach:tokreach_password@localhost:5432/tokreach_db?schema=public"

# Redis (BullMQ Outreach & Usage-Rights Queue)
REDIS_URL="redis://localhost:6379"

# AI Enrichment & Pitch Personalization (Optional - falls back to deterministic rule engine)
GEMINI_API_KEY=""

# Email Outreach & Notification SMTP (Optional - logs sent emails in dev mode when omitted)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="outreach@tokreach.app"
