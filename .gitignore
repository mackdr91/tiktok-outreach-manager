# Author: Domonick Mack
# Date: 2026-11-15
# Description: Git ignore rules for Node.js, Next.js, Prisma, Docker, and macOS artifacts.

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
.vitest/

# Next.js build output
.next/
out/
build/
dist/

# Environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS & Editor files
.DS_Store
*.pem
.vscode/
.idea/

# TypeScript & Prisma
*.tsbuildinfo
next-env.d.ts
prisma/*.db
prisma/*.db-journal

# Docker local volumes
.docker-data/
postgres-data/
redis-data/
