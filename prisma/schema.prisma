// Description: Prisma ORM database configuration and baseline schema definition.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemHealth {
  id        String   @id @default(cuid())
  service   String   @unique
  status    String
  updatedAt DateTime @updatedAt
}
